# Copy this file to .env and fill in the provider. .env is gitignored.
# npm run dev:api and docker compose read it. The browser never receives the key.

EsrAi__BaseUrl=
EsrAi__Model=
EsrAi__ApiKey=

# Optional. Uncomment to override the defaults.
# EsrAi__CompletionsPath=chat/completions
# EsrAi__AuthHeader=Authorization
# EsrAi__AuthScheme=Bearer
