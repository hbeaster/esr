# Copy to .env and fill in. Docker Compose reads .env from this directory.
# .env is git-ignored. Never commit a real key.

# Assistant chat provider: any OpenAI-compatible Chat Completions endpoint.
# Leave CHAT_API_KEY empty to use the labeled mock assistant.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# Other provider examples:
# CHAT_BASE_URL=https://api.anthropic.com/v1/
# CHAT_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the host machine
